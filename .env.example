# =============================================================================
# Copy to .env and fill in real values. NEVER commit the real .env.
# =============================================================================

# --- Supabase (browser-visible) ---------------------------------------------
# Vite only exposes variables prefixed with VITE_ to the client bundle.
# The publishable key is designed to be public (protected by RLS).
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (server-side) --------------------------------------------------
# Read by SSR / server functions via process.env.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# SECRET. Bypasses RLS. Server-only — never prefix with VITE_, never expose.
# Required by phone sign-up (src/integrations/supabase/client.server.ts).
SUPABASE_SERVICE_ROLE_KEY=

# --- Dify (server-side) ------------------------------------------------------
# SECRET. Required for AI chat. Get it from your Dify app (starts with "app-").
DIFY_API_KEY=
# Optional. Only for self-hosted Dify; defaults to https://api.dify.ai/v1
DIFY_API_BASE=

# --- Knowledge Provider (server-side) ---------------------------------------
# none = no knowledge backend (default; no network calls).
# sag  = future SAG knowledge base (reserved; not implemented yet).
KNOWLEDGE_PROVIDER=none
# SECRET. Only used when KNOWLEDGE_PROVIDER=sag. Server-only, never exposed.
SAG_BASE_URL=
SAG_API_KEY=
SAG_TIMEOUT_MS=10000
